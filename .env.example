# Copy to .env and fill in. Never commit .env.
# API
LEXPERT_ENV=development
LEXPERT_DATABASE_URL=postgresql+psycopg://lexpert:lexpert@localhost:5432/lexpert
LEXPERT_JWT_SECRET=change-me-in-every-environment
LEXPERT_JWT_ACCESS_TTL_MINUTES=15
LEXPERT_JWT_REFRESH_TTL_DAYS=30

# Escrow simulator (MVP - no real funds move)
LEXPERT_ESCROW_PROVIDER=simulator
LEXPERT_ESCROW_HOLD_WINDOW_MINUTES=60
LEXPERT_PLATFORM_COMMISSION_BPS=1500

# Video provider
LEXPERT_VIDEO_PROVIDER=livekit
LEXPERT_VIDEO_API_KEY=
LEXPERT_VIDEO_API_SECRET=
LEXPERT_VIDEO_URL=

# Notifications
LEXPERT_SMTP_URL=
LEXPERT_SMS_PROVIDER=
LEXPERT_SMS_API_KEY=

# Object storage for KYC documents
LEXPERT_STORAGE_BACKEND=local
LEXPERT_STORAGE_ROOT=./storage

# Web
VITE_API_BASE_URL=http://localhost:8000
